{
  "version": 2,
  "buildCommand": "bash scripts/install-tectonic.sh && npm run build:client",
  "outputDirectory": "dist/client",
  "builds": [
    {
      "src": "src/server/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "dist/**",
          ".bin/tectonic"
        ]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/client" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/src/server/index.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
