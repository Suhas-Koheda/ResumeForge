# Server Config
PORT=5000
NODE_ENV=production

# Security
JWT_SECRET=your_high_entropy_random_string_here
ALLOWED_ORIGINS=https://yourfrontend.com,http://localhost:5173

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/resumeforge

# AI (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Dev Flag
IS_LOCAL=true
