GEMINI_API_KEY=your_primary_gemini_api_key_here
GEMINI_API_KEYS=key1,key2,key3
# (Optional) Comma-separated list of extra keys for automatic rotation

# --- Backend Configuration ---
# Set to 'false' for production mode (Auth required, Cloud DB required)
IS_LOCAL=true
JWT_SECRET=super_secret_for_production
MONGODB_URI=mongodb://localhost:27017/resumeforge
PORT=5000

# --- Email (SMTP) Configuration ---
# For local testing, you can use Mailpit (localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ResumeForge" <noreply@resumeghaasforge.tech>
APP_URL=http://localhost:5173