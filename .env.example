# --- Database Configuration (PostgreSQL/SQLite) ---
# For Local development: uses SQLite (local_dev.sqlite) automatically when IS_LOCAL=true
# For Production: provide your Postgres connection details
DB_URL=postgres://user:password@hostname:5432/dbname
DB_USERNAME=
DB_PASSWORD=

# --- Google Gemini API ---
# Models: gemini-1.5-flash (stable), gemini-2.5-flash (experimental)
GEMINI_MODEL_NAME=gemini-2.5-flash
# Comma-separated list of API keys for rotation
GEMINI_API_KEYS=AIzaSy... , AIzaSy...

# --- Backend & Mode Settings ---
# Set to true to bypass auth and use local SQLite database
IS_LOCAL=true
VITE_IS_LOCAL=true
JWT_SECRET=your_super_long_random_jwt_secret_here
