# === RESUME FORGE LOCAL SETTINGS ===

# --- Mode Flags ---
# Set both to true for immediate local canvas access & SQLite DB
IS_LOCAL=true
VITE_IS_LOCAL=true

# --- Google Gemini API ---
# Models: gemini-1.5-flash (stable), gemini-2.5-flash (experimental)
GEMINI_MODEL_NAME=gemini-2.5-flash
# Comma-separated list of API keys for rotation
GEMINI_API_KEYS=AIzaSy... , AIzaSy...

# --- Backend Config ---
# Used for session security
JWT_SECRET=your_super_long_random_jwt_secret_here

# --- App URL ---
# Local dev default
APP_URL=http://localhost:5173

# NOTE: SMTP/Email settings are NOT required for local use.
# Local mode automatically bypasses verification.
